<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 规则库对外产物：同时生成 XML 文档，打包时一起给宿主 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591：大量内部类型没写 XML 注释，不因此报警 -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tiisu.Core\Tiisu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tiisu.Engine.Tests" />
  </ItemGroup>

</Project>
