<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SkiaSharp.Views.WindowsForms 只提供 net*-windows10.0.19041 资产，TFM 必须是这个 -->
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Tiisu.Mahjong</AssemblyName>
    <RootNamespace>Tiisu.App</RootNamespace>
    <!-- Release 发布：单文件 + 原生库自解压 + 不产 PDB（体积约 270MB -> 155MB） -->
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(Configuration)' == 'Release'">true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.153.1" />
    <!-- 牌桌布局引擎（Facebook Yoga 的 .NET 绑定，自带 win-x64 原生 yoga.dll） -->
    <PackageReference Include="YogaSharp.Layout" Version="1.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tiisu.Core\Tiisu.Core.csproj" />
    <ProjectReference Include="..\Tiisu.Engine\Tiisu.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 牌面雪碧图（由 Web/scripts/export_tiles.py 生成）随程序输出 -->
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Generated/BuildInfo.g.cs 由下面的 Target 每次编译前重建，别再让默认 glob 收一遍（会重复 Include）。 -->
  <ItemGroup>
    <Compile Remove="Generated\**\*.cs" />
  </ItemGroup>

  <!--
    构建时由 tools/get-buildinfo.ps1 从 git 取 short hash + 提交日期（yymmdd）生成版本号；
    工作区有未提交改动时加 +，没有 git / 取不到信息时降级为 dev。
    脚本同时负责写文件，避免 MSBuild 输出重定向对 % 与分号的转义问题。
  -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_TiisuBuildInfoFile>$(MSBuildProjectDirectory)\Generated\BuildInfo.g.cs</_TiisuBuildInfoFile>
    </PropertyGroup>

    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\get-buildinfo.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)\..\..&quot; -OutFile &quot;$(_TiisuBuildInfoFile)&quot;"
          StandardOutputImportance="low" StandardErrorImportance="low" />

    <!-- 首次生成时文件还不存在，默认 glob 没收到它：这里补进编译列表。 -->
    <ItemGroup>
      <Compile Include="$(_TiisuBuildInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
